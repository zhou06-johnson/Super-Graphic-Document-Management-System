# Copy this file to .env, then fill in the keys you actually use.
SILICONFLOW_API_KEY=
AMAP_WEB_KEY=
ENABLE_MONGODB_BOOTSTRAP=1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=MemoirsCore
# Set 0.0.0.0 only when iOS devices on your local Wi-Fi need to connect.
MEMOIRS_HOST=0.0.0.0
MEMOIRS_PORT=8000

# MemoirsCore AI editor uses DeepSeek for media tags and edit plans.
DEEPSEEK_API_KEY=
# Optional local faster-whisper model directory for timestamped video dialogue.
MEMOIRS_ASR_MODEL_PATH=
# Optional Volcengine Ark credentials and Seedance deployment/model ID.
# Example model ID: doubao-seedance-2-5-flash-261115
ARK_API_KEY=
MEMOIRS_SEEDANCE_MODEL=
